{
  "name": "gestion-stock-importaciones-wintech",
  "version": "0.1.0",
  "private": true,
  "description": "Gestion de stock y recomendacion de importaciones para un distribuidor de insumos de aberturas de PVC (single-user, Windows, offline).",
  "author": "Lucas Melchior",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http-get://localhost:5173 && electron .\"",
    "start": "electron .",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.wintech.gestionstock",
    "productName": "Gestion de Stock Wintech",
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "build/renderer/**/*",
      "db/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "exceljs": "^4.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  }
}
